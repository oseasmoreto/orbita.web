# URL base da API consumida pelo frontend (axios client, core/api/client.ts)
VITE_API_BASE_URL=http://localhost:8000/v1

# URL usada só em dev/CI pra gerar src/core/api/schema.d.ts (openapi-typescript
# busca ${API_OPENAPI_URL}/docs/api.json) — nunca lida em runtime pelo app
API_OPENAPI_URL=http://localhost:8000
