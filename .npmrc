# openapi-typescript (dev-only codegen tool, npm run generate:api-types —
# nunca importado no bundle/build do app) declara peer typescript@^5.x em
# toda a série 7.x; o projeto fixa typescript em ~6.0.3 de propósito
# (docs/design/design-system.md §15.5, compat com @typescript-eslint) —
# sem esse par de versões nunca vai bater, então `npm ci`/`npm install`
# falham com ERESOLVE do zero (achado real: aconteceu no build do Dokploy,
# reproduzido localmente também — `node_modules` local só funcionava por
# nunca ter sido reinstalado do zero desde que esse conflito surgiu).
legacy-peer-deps=true
