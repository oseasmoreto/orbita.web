# Build
FROM node:24-alpine AS builder

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

# .env.production está commitado (decisão do time: só valores públicos,
# sem segredo) — vite build roda em modo production por padrão e já
# carrega esse arquivo sozinho. Nunca passar VITE_API_BASE_URL via
# ARG/ENV aqui: um build arg vazio (Dokploy sem o campo preenchido)
# sobrescreveria silenciosamente o valor correto do .env.production,
# porque env de processo tem precedência maior que .env.[modo] no Vite.
RUN npm run build

# Runtime
FROM nginx:1.27-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 5173

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:5173/ || exit 1

CMD ["nginx", "-g", "daemon off;"]